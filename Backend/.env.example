# ─────────────────────────────────────────────────────
# CourseCloud Backend — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────

# Supabase project URL (found in Project Settings → API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key — grants full DB + Storage access.
# Keep this secret. Only use on the server, never in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Port for the Express server (defaults to 4000 if omitted)
PORT=4000

# Allowed origin for CORS — should match your frontend URL in development
# e.g. http://localhost:5173 for Vite, or your production domain
FRONTEND_URL=http://localhost:5173
